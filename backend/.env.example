# ─────────────────────────────────────────────────────────────────────────────
# Adigrat Community Connect — backend environment
#
# Copy to `.env` and fill in. NEVER commit a real `.env`; it is gitignored.
#
#   cp .env.example .env
#
# Every variable below is validated at startup. A missing or invalid value stops
# the process with a readable message rather than surfacing as a confusing
# failure at first use.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── database ────────────────────────────────────────────────────────────────
#
# Standard form for a normal install with password auth:
#   DATABASE_URL="postgresql://acc_app:CHANGE_ME@127.0.0.1:5432/acc_dev?schema=public"
#
# Socket form used on a machine whose pg_hba allows peer/trust auth on the local
# socket but requires a password over TCP:
#   DATABASE_URL="postgresql://filmon@localhost/acc_dev?host=/var/run/postgresql"
DATABASE_URL="postgresql://CHANGE_ME@127.0.0.1:5432/acc_dev?schema=public"

# ── frontend / CORS ──────────────────────────────────────────────────────────
#
# Comma-separated exact origins. "*" is rejected: staff authentication is
# cookie-based, so credentialed requests need an explicit allowlist.
CORS_ORIGINS="http://localhost:3000"

# Public address of the web app. Used for links inside notifications.
PUBLIC_WEB_URL="http://localhost:3000"

# Number of reverse proxies in front of the API. Sets `trust proxy`, which
# determines whether req.ip is the real client. 0 means the API is exposed
# directly. Getting this wrong makes rate limiting and audit logs wrong or
# spoofable — set it deliberately, not by guesswork.
TRUST_PROXY_HOPS=0

# ── authentication ──────────────────────────────────────────────────────────
#
# Generate with:  openssl rand -base64 48
# Rotating this signs out every session and invalidates stored TOTP secrets, so
# everyone with MFA must re-enrol. That is the correct behaviour for a suspected
# compromise, but plan for it.
JWT_ACCESS_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Argon2id parameters (OWASP baseline: 19 MiB, t=2, p=1). Raising these is always
# safe; lowering them weakens every stored password.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Failed sign-in attempts before the account locks.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── CSRF ────────────────────────────────────────────────────────────────────
CSRF_COOKIE_NAME=acc_csrf
CSRF_HEADER_NAME=x-acc-csrf

# ── cookies ─────────────────────────────────────────────────────────────────
AUTH_COOKIE_NAME=acc_access
REFRESH_COOKIE_NAME=acc_refresh
# Leave unset when the API and web app share a registrable domain. Set it only
# when they are on genuinely different domains.
COOKIE_DOMAIN=
# Forced to true in production regardless of this value.
COOKIE_SECURE=false

# ── attachment storage ──────────────────────────────────────────────────────
#
# MUST be an absolute path outside anything a web server serves. In the pilot
# this is a Docker volume mounted only into the API container. The directory is
# created 0o700 and no static middleware ever serves from it.
STORAGE_ROOT="./storage"

MAX_ATTACHMENT_BYTES=8388608
ALLOWED_ATTACHMENT_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ── rate limiting ───────────────────────────────────────────────────────────
#
# Per client IP. Raise these for a pilot reached through a single shared
# connection: every resident behind one address shares one budget, so values
# tuned for a public internet site would lock out a whole room at once.
#
# Reporting is per-window request counts, not per-minute averages, so a short
# window with a modest count is the safer shape.
#
# NOTE: these are consumed by `src/config/rate-limits.ts`, which is read at
# startup — the same values apply everywhere, and none of them is a per-route
# default that a controller can silently override.
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300

# Report submission: the most abused and most expensive endpoint. Deliberately
# small and separate from the general limit above, so raising everyday traffic
# cannot loosen it.
RATE_LIMIT_SUBMISSION_WINDOW_MS=600000
RATE_LIMIT_SUBMISSION_MAX=5

# Status lookup. Discourages guessing reference codes; the status token is what
# actually protects the endpoint.
RATE_LIMIT_STATUS_LOOKUP_WINDOW_MS=600000
RATE_LIMIT_STATUS_LOOKUP_MAX=10

# Sign-in. The endpoint worth brute-forcing. Account lockout is the second layer
# behind this one.
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5

# Token refresh. Higher than sign-in: a browser tab left open refreshes by itself,
# and one household may share a device.
RATE_LIMIT_REFRESH_WINDOW_MS=600000
RATE_LIMIT_REFRESH_MAX=30

# Password recovery. Small on purpose: this route sends messages to an address,
# and an unthrottled one becomes a mail relay.
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=3

# ── behaviour flags ─────────────────────────────────────────────────────────
#
# Anonymous reporting stays OFF until the operating organization has approved
# the process. The platform cannot genuinely deliver anonymity: access logs,
# request metadata and file metadata can all identify a submitter. Enabling this
# lets the platform make a promise it cannot keep.
ALLOW_ANONYMOUS_REPORTS=false

# Precise coordinates. Off by default — a landmark description or kebele name is
# almost always sufficient, and coordinates identify a household directly.
ALLOW_PRECISE_LOCATIONS=false

# Marks uploads CLEAN without running a malware scanner. MUST be false outside
# local development; the schema refuses to start in production with this true.
SKIP_MALWARE_SCAN=true

# Swagger UI at /api/v1/docs. Turn off before a public pilot deployment.
ENABLE_SWAGGER=true

# No SMS or email provider is wired in the pilot, so leaving this false is the
# honest configuration: notifications queue and stay visibly unsent.
ENABLE_NOTIFICATION_WORKER=false

# ── data protection ─────────────────────────────────────────────────────────
#
# Bump when the privacy notice changes. Recorded on every ConsentRecord so the
# consent given can be tied to the exact wording the resident was shown.
PRIVACY_POLICY_VERSION="draft-2026-01"

# Months a closed report is retained before purge. See docs/08-data-retention-policy.md.
DATA_RETENTION_MONTHS=24

# Must be a monitored address before any real deployment. RFC 2606 `.invalid`
# is used here because no mailbox exists yet.
DATA_PROTECTION_CONTACT_EMAIL="privacy@acc.invalid"

# ── test-only ───────────────────────────────────────────────────────────────
#
# Multiplies every rate limit above. Used ONLY by the automated test suite, which
# would otherwise trip the shipped limits on its seventh request. Defaults to 1,
# is ignored unless it is a positive integer, and must never be set in a real
# deployment: a value of 1000 here would remove flood protection entirely.
# See backend/src/config/rate-limits.ts.
# TEST_THROTTLE_MULTIPLIER=1
